// Memory.hdl - Hack memory map
//   0     .. 16383 : RAM16K
//   16384 .. 24575 : Screen
//   24576          : Keyboard
// Address bits 14 and 13 pick the region:
//   00, 01 -> RAM   10 -> Screen   11 -> Keyboard
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    DMux4Way(in=load, sel=address[13..14], a=loadRam0, b=loadRam1, c=loadScreen, d=loadKbd);
    Or(a=loadRam0, b=loadRam1, out=loadRam);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut, sel=address[13..14], out=out);
}
